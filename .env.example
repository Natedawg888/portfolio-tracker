# Akahu — banks / Sharesies / Hatch / KiwiSaver sync
# Personal App (shared household token): APP_ID + USER_TOKEN from https://my.akahu.nz → Developers
AKAHU_APP_ID=
AKAHU_USER_TOKEN=

# Full App OAuth (optional — per-user Settings → Connect with Akahu)
# Requires a Full App from Akahu; Personal Apps cannot use OAuth.
AKAHU_APP_SECRET=
# Encrypt OAuth user tokens in akahu_connections (AES-256-GCM). 32-byte key: standard base64 or 64 hex chars.
# Required in production to store a new token. Never commit a real key.
# Plaintext rows from before this key still load, and are encrypted when next read.
AKAHU_TOKEN_ENCRYPTION_KEY=
# First signup claims existing finance/bank rows only when this is set on the server.
# Leave unset for a normal empty install (first account still works) and for any database
# that already has holdings, accounts, or bank data you do not intend to hand over.
# ALLOW_EXISTING_DATA_CLAIM=1
# Must match a Redirect URI registered on the Akahu app (Vite proxies /api → API):
AKAHU_REDIRECT_URI=http://127.0.0.1:3000/api/akahu/callback
AKAHU_FRONTEND_URL=http://127.0.0.1:3000

# Optional. Live NZD metal spots use gold-api.com with no key.
# If set, Metals.Dev is used instead: https://metals.dev/
METALS_API_KEY=

# Portfolio news (nav: News). Google News and BBC RSS are public.
# No API key. A failed feed stays empty.
# Optional: NEWS_LIVE=1 also hits those feeds in `npm run test:news`.

# Crypto wallets (read-only). Server-side only — never sent to the browser.
# Without these, each network uses a public keyless endpoint (rate-limited).
# Keys may be embedded in the URL (Alchemy/Infura style) or set as *_API_KEY (sent as x-api-key).
# CHAIN_ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<key>
# CHAIN_POLYGON_RPC_URL=
# CHAIN_BASE_RPC_URL=
# CHAIN_ARBITRUM_RPC_URL=
# CHAIN_SOLANA_RPC_URL=
# CHAIN_BITCOIN_RPC_URL=      # Esplora REST base, e.g. https://blockstream.info/api
# CHAIN_<NETWORK>_API_KEY=
# CHAIN_ETHEREUM_INDEXER_URL=  # ERC-20 discovery + history: Blockscout API v2 base (default https://eth.blockscout.com/api/v2)
# CHAIN_POLYGON_INDEXER_URL= / CHAIN_BASE_INDEXER_URL= / CHAIN_ARBITRUM_INDEXER_URL=  # optional; without one, well-known tokens only

# Precious stones (diamonds): OpenFacet MCP — no API key
# https://openfacet.net/ · POST https://mcp.openfacet.net/
# Non-diamond gems: manual estimated NZD only (never invent).


# --- Hosted / production (see .env.production.example + docs/DEPLOY.md) ---
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=8080
# COOKIE_SECURE=true
# TRUST_PROXY=1
# PUBLIC_URL=https://your-app.up.railway.app
# DATABASE_PATH=/app/data/portfolio.db

# --- Two-factor sign-in (KAN-16) ---
# 32-byte key that seals 2FA secrets at rest. Generate: openssl rand -hex 32
# Unset locally: a key is generated at data/secrets/auth.key. Set it in production.
# AUTH_ENCRYPTION_KEY=

# --- Sign in with Google / Apple / Microsoft (optional; see docs/AUTH.md) ---
# Callback URL to register: ${PUBLIC_URL}/api/auth/sso/<provider>/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# APPLE_CLIENT_ID=            # Services ID
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=          # .p8 contents; newlines as \n
# --- Invoices (KAN-71) ---
# Optional. Without these, invoices are sent from the user's own email app or the device
# share sheet (with a read-only link); in-app sending with the PDF attached is switched off.
# Resend: https://resend.com — verify the sending domain (SPF / DKIM DNS records) first.
# RESEND_API_KEY=
# INVOICE_EMAIL_FROM=invoices@mail.your-domain.nz
# Per-user caps on emails the app sends (defaults 10 an hour, 30 a day).
# INVOICE_SEND_HOURLY_LIMIT=10
# INVOICE_SEND_DAILY_LIMIT=30
# Share links use PUBLIC_URL (above) as their base in production.

# --- Ads (KAN-72; see docs/ADS.md) ---
# Kill switch: ads show only when this is true. Read on every request, so a restart is enough.
# ADS_ENABLED=false
# Google AdSense publisher id and ad unit ids. Without them, development shows placeholder boxes
# and production shows nothing.
# ADSENSE_CLIENT_ID=ca-pub-2417043695803227
# ADSENSE_SLOT_LEFT=     # 160×600, wide desktop
# ADSENSE_SLOT_RIGHT=    # 160×600, wide desktop
# ADSENSE_SLOT_BOTTOM=   # bottom banner: 320×50 phones, 728×90 tablets and narrower windows

# Plans (KAN-77), until billing exists: comma-separated emails on Plus / Pro (households need Plus).
PLAN_PLUS_EMAILS=
PLAN_PRO_EMAILS=

# Earnings report dates for held US-listed stocks on the Calendar (finnhub.io, free key).
# Unset: the Calendar says earnings data is not connected and shows none.
# FINNHUB_API_KEY=
