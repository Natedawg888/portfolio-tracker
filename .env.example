# Akahu — banks / Sharesies / Hatch / KiwiSaver sync
# Personal App (shared household token): APP_ID + USER_TOKEN from https://my.akahu.nz → Developers
AKAHU_APP_ID=
AKAHU_USER_TOKEN=

# Full App OAuth (optional — per-user Settings → Connect with Akahu)
# Requires a Full App from Akahu; Personal Apps cannot use OAuth.
AKAHU_APP_SECRET=
# Must match a Redirect URI registered on the Akahu app (Vite proxies /api → API):
AKAHU_REDIRECT_URI=http://127.0.0.1:3000/api/akahu/callback
AKAHU_FRONTEND_URL=http://127.0.0.1:3000

# Optional. Live NZD metal spots use gold-api.com with no key.
# If set, Metals.Dev is used instead: https://metals.dev/
METALS_API_KEY=

# Portfolio news (nav: News). Google News and BBC RSS are public.
# No API key. A failed feed stays empty.
# Optional: NEWS_LIVE=1 also hits those feeds in `npm run test:news`.

# Crypto wallets (read-only). Server-side only — never sent to the browser.
# Without these, each network uses a public keyless endpoint (rate-limited).
# Keys may be embedded in the URL (Alchemy/Infura style) or set as *_API_KEY (sent as x-api-key).
# CHAIN_ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<key>
# CHAIN_POLYGON_RPC_URL=
# CHAIN_BASE_RPC_URL=
# CHAIN_ARBITRUM_RPC_URL=
# CHAIN_SOLANA_RPC_URL=
# CHAIN_BITCOIN_RPC_URL=      # Esplora REST base, e.g. https://blockstream.info/api
# CHAIN_<NETWORK>_API_KEY=
# CHAIN_ETHEREUM_INDEXER_URL=  # ERC-20 discovery + history: Blockscout API v2 base (default https://eth.blockscout.com/api/v2)
# CHAIN_POLYGON_INDEXER_URL= / CHAIN_BASE_INDEXER_URL= / CHAIN_ARBITRUM_INDEXER_URL=  # optional; without one, well-known tokens only

# Precious stones (diamonds): OpenFacet MCP — no API key
# https://openfacet.net/ · POST https://mcp.openfacet.net/
# Non-diamond gems: manual estimated NZD only (never invent).


# --- Hosted / production (see .env.production.example + docs/DEPLOY.md) ---
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=8080
# COOKIE_SECURE=true
# TRUST_PROXY=1
# PUBLIC_URL=https://your-app.up.railway.app
# DATABASE_PATH=/app/data/portfolio.db
