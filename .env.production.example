# Production / hosted example — copy values into Railway (or Fly/Render) Variables.
# Never commit real secrets. Do not overwrite a live workstation .env with this file.

NODE_ENV=production
HOST=0.0.0.0
PORT=8080

# Public site URL (no trailing slash). Used for logs / cookie Secure heuristics.
PUBLIC_URL=https://your-app.up.railway.app

# Session cookie: set true behind HTTPS (Railway/Fly terminate TLS).
COOKIE_SECURE=true
# Trust X-Forwarded-* from the platform proxy (required for Secure cookies + correct IPs).
TRUST_PROXY=1

# --- Akahu (banks / Sharesies / Hatch / KiwiSaver) ---
AKAHU_APP_ID=
AKAHU_USER_TOKEN=
# Full App OAuth (recommended for multi-user):
AKAHU_APP_SECRET=
AKAHU_REDIRECT_URI=https://your-app.up.railway.app/api/akahu/callback
AKAHU_FRONTEND_URL=https://your-app.up.railway.app

# --- Metals.Dev (optional; never invents prices) ---
METALS_API_KEY=

# SQLite path override (default: ./data/portfolio.db). On Railway use a volume at /app/data.
# DATABASE_PATH=/app/data/portfolio.db

# Structured logs: json | pretty  (default json when NODE_ENV=production)
LOG_FORMAT=json
